{
  "openapi": "3.1.0",
  "info": {
    "title": "Docmost Service Bridge (east-west)",
    "version": "1.1.0",
    "summary": "The east-west endpoints this Docmost fork EXPOSES to an integrating platform.",
    "description": "These are the machine-to-machine endpoints the fork hosts for an integrating platform (the inverse direction of authorization-service.openapi.json, which the fork calls). They exist so an external identity/session broker can provision a fork-local shadow user and mint a Docmost session for it, force-disconnect a live collab session after a revocation, and (Phase C) administer workspace settings + spaces and read the content model WITHOUT the platform reaching into Docmost's database directly. They are NOT part of the public north-south API and are not browser-facing.\n\nMode: the whole surface is 404 unless the fork runs with AUTHZ_MODE=remote (RemoteOnlyGuard, checked BEFORE the secret). In AUTHZ_MODE=native there is no integrating platform and every route below returns 404 for all callers.\n\nAuth: every request carries a shared service secret in the x-authz-service-secret header (PLATFORM_AUTHZ_SERVICE_SECRET). Each /api/service/* route additionally requires exactly one least-privilege scope: session:mint, users:provision, users:resolve, workspace:read, workspace:settings:write, spaces:read, spaces:write, pages:read, content:read. Today a single full-scope secret is issued; per-scope credentials can be added later with no contract change.\n\nSecurity properties an integrator must understand:\n  - Identity-mutating endpoints are keyed ONLY on the caller's opaque externalId. The fork derives the shadow email (externalId@shadow.wiki-v2.internal) and resolves its own default workspace, so a caller can never select an arbitrary Docmost identity, name a real/privileged/native account, or supply a workspace id. This is a strong narrowing, not impersonation.\n  - The platform is the authorization authority: it performs the PDP decision (space/workspace administer, or the filter-then-retrieve authorized-id set) BEFORE calling these endpoints. The content read endpoints are a PRIVILEGED DATA PLANE, not a second gate: they return metadata for exactly the supplied ids and do NOT re-authorize. The security of the caller's /v1 surface rests entirely on it passing an authorized id set.\n  - Fail-closed: not remote -> 404; unconfigured secret -> 503; missing/wrong secret -> 401; wrong scope -> 403; over the per-credential rate limit -> 429; invalid body -> 400.",
    "license": { "name": "AGPL-3.0-only", "identifier": "AGPL-3.0-only" },
    "x-canonical": true
  },
  "servers": [
    {
      "url": "https://your-docmost.example",
      "description": "The Docmost fork base URL (e.g. http://localhost:3000 in dev). The global prefix /api is included in the paths below."
    }
  ],
  "security": [{ "serviceSecret": [] }],
  "tags": [
    { "name": "service-bridge", "description": "Shadow-user provisioning and session brokerage (authentication, not authorization)." },
    { "name": "workspace", "description": "Canonical-workspace resolution and platform-governed workspace settings." },
    { "name": "spaces", "description": "The platform-governed space + membership control plane (data only; the platform authorizes first)." },
    { "name": "pages", "description": "Bounded page lookups (structural) for the platform's authorization + content reads." },
    { "name": "content", "description": "The /v1 filter-then-retrieve read model (privileged data plane; trusts the platform's authorized id set)." },
    { "name": "collab", "description": "Collaboration session control." }
  ],
  "paths": {
    "/api/service/users": {
      "post": {
        "operationId": "provisionShadowUser",
        "tags": ["service-bridge"],
        "summary": "Provision (idempotently) a fork-local shadow user for an external identity.",
        "description": "Create-or-return a shadow user for the caller's externalId in the fork's own default workspace, with role=member and an unusable password. Idempotent on (derived shadow email, workspace). Scope: users:provision.",
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/ProvisionUserRequest" },
          "example": { "externalId": "ext-abc123", "name": "Ada Lovelace" }
        } } },
        "responses": {
          "200": { "description": "The provisioned (or existing) shadow user and the fork's resolved workspace.", "content": { "application/json": {
            "schema": { "$ref": "#/components/schemas/ProvisionedUser" },
            "example": { "userId": "9b1f0c2e-0000-4000-8000-000000000001", "workspaceId": "9b1f0c2e-0000-4000-8000-0000000000ff" }
          } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/users/resolve": {
      "post": {
        "operationId": "resolveUser",
        "tags": ["service-bridge"],
        "summary": "Resolve a Docmost user id to its workspace (existence check).",
        "description": "Read-only lookup of the workspace a Docmost user belongs to. Used by the platform to reverse-provision a PDP anchor for a Docmost-native user it has no mapping for. Scope: users:resolve.",
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/ResolveUserRequest" },
          "example": { "userId": "9b1f0c2e-0000-4000-8000-000000000001" }
        } } },
        "responses": {
          "200": { "description": "The user's workspace id.", "content": { "application/json": {
            "schema": { "$ref": "#/components/schemas/ProvisionedUser" }
          } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/session": {
      "post": {
        "operationId": "mintSession",
        "tags": ["service-bridge"],
        "summary": "Mint a Docmost session cookie for a fork-owned shadow member.",
        "description": "Look up the shadow user by the email derived from externalId, verify it is a mintable shadow member (shadow namespace, role=member, not deleted), and mint a Docmost session. Returns { ok: true } and sets the authToken cookie (httpOnly, sameSite=lax, path=/, secure in prod). Scope: session:mint. There is NO generic impersonation: a non-shadow / non-member / deleted / unknown subject is 403.",
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/MintSessionRequest" },
          "example": { "externalId": "ext-abc123" }
        } } },
        "responses": {
          "200": {
            "description": "Session minted; the authToken cookie is set via Set-Cookie.",
            "headers": { "Set-Cookie": { "description": "authToken=<jwt>; HttpOnly; SameSite=Lax; Path=/; Secure (in production).", "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "type": "object", "required": ["ok"], "properties": { "ok": { "type": "boolean" } } }, "example": { "ok": true } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "description": "Not a mintable shadow user (unknown, deleted, wrong role, or outside the shadow namespace).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/workspace/default": {
      "get": {
        "operationId": "getDefaultWorkspace",
        "tags": ["workspace"],
        "summary": "The fork's canonical (oldest non-deleted) workspace id.",
        "description": "The single source of truth for the canonical workspace id in this single-tenant deployment. Scope: workspace:read.",
        "responses": {
          "200": { "description": "The canonical workspace id.", "content": { "application/json": { "schema": { "type": "object", "required": ["workspaceId"], "properties": { "workspaceId": { "type": "string", "format": "uuid" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/workspace/settings": {
      "get": {
        "operationId": "getWorkspaceSettings",
        "tags": ["workspace"],
        "summary": "Read the workspace name + default page-edit mode.",
        "description": "Scope: workspace:read.",
        "responses": {
          "200": { "description": "The current settings.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspaceSettings" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      },
      "patch": {
        "operationId": "updateWorkspaceSettings",
        "tags": ["workspace"],
        "summary": "Update the workspace name and/or default page-edit mode.",
        "description": "Partial update; the settings JSONB is shallow-merged (sibling keys preserved). The platform authorizes workspace#administer first. Scope: workspace:settings:write.",
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/UpdateWorkspaceSettingsRequest" },
          "example": { "defaultPageEditMode": "edit" }
        } } },
        "responses": {
          "200": { "description": "The updated settings.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspaceSettings" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/spaces": {
      "get": {
        "operationId": "listSpaces",
        "tags": ["spaces"],
        "summary": "List non-personal spaces (with member counts).",
        "description": "Archived spaces are hidden unless includeArchived=true. Scope: spaces:read.",
        "parameters": [{ "name": "includeArchived", "in": "query", "required": false, "schema": { "type": "boolean" } }],
        "responses": {
          "200": { "description": "Spaces in the workspace.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/SpaceView" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      },
      "post": {
        "operationId": "createSpace",
        "tags": ["spaces"],
        "summary": "Create a space and add the creator as its admin member (atomically).",
        "description": "Both the space row and the creator-admin member row are written in ONE transaction so the outbox projects them together. The creator is resolved from creatorExternalId. Scope: spaces:write.",
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/CreateSpaceRequest" },
          "example": { "name": "Engineering", "creatorExternalId": "ext-abc123" }
        } } },
        "responses": {
          "200": { "description": "The created space.", "content": { "application/json": { "schema": { "type": "object", "required": ["id", "slug", "name"], "properties": { "id": { "type": "string", "format": "uuid" }, "slug": { "type": "string" }, "name": { "type": ["string", "null"] } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/spaces/{spaceId}": {
      "parameters": [{ "name": "spaceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": {
        "operationId": "getSpace",
        "tags": ["spaces"],
        "summary": "Space detail (with member count).",
        "description": "Scope: spaces:read.",
        "responses": {
          "200": { "description": "The space.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SpaceView" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      },
      "patch": {
        "operationId": "updateSpace",
        "tags": ["spaces"],
        "summary": "Rename / re-describe a space (slug is stable).",
        "description": "Scope: spaces:write.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateSpaceRequest" } } } },
        "responses": {
          "200": { "$ref": "#/components/responses/Ok" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/spaces/{spaceId}/archive": {
      "parameters": [{ "name": "spaceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "post": {
        "operationId": "archiveSpace",
        "tags": ["spaces"],
        "summary": "Archive a space (reversible soft-delete).",
        "description": "Scope: spaces:write.",
        "responses": {
          "200": { "$ref": "#/components/responses/Ok" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/spaces/{spaceId}/unarchive": {
      "parameters": [{ "name": "spaceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "post": {
        "operationId": "unarchiveSpace",
        "tags": ["spaces"],
        "summary": "Restore an archived space.",
        "description": "Scope: spaces:write.",
        "responses": {
          "200": { "$ref": "#/components/responses/Ok" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/spaces/{spaceId}/members": {
      "parameters": [{ "name": "spaceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": {
        "operationId": "listSpaceMembers",
        "tags": ["spaces"],
        "summary": "Raw space members (Docmost user/group ids).",
        "description": "Returns Docmost user/group ids ONLY; the platform maps user ids back to its own identities. Scope: spaces:read.",
        "responses": {
          "200": { "description": "The space members.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/RawSpaceMember" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      },
      "post": {
        "operationId": "addSpaceMember",
        "tags": ["spaces"],
        "summary": "Add (or re-add / re-role) a shadow user as a space member.",
        "description": "The member + adder are resolved from their externalIds. Scope: spaces:write.",
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/AddSpaceMemberRequest" },
          "example": { "externalId": "ext-def456", "role": "writer", "addedByExternalId": "ext-abc123" }
        } } },
        "responses": {
          "200": { "description": "The upserted member.", "content": { "application/json": { "schema": { "type": "object", "required": ["memberId", "userId"], "properties": { "memberId": { "type": "string", "format": "uuid" }, "userId": { "type": "string", "format": "uuid" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/spaces/{spaceId}/members/{memberId}": {
      "parameters": [
        { "name": "spaceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "memberId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "patch": {
        "operationId": "changeSpaceMemberRole",
        "tags": ["spaces"],
        "summary": "Change a member's space role.",
        "description": "Scope: spaces:write.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateSpaceMemberRequest" } } } },
        "responses": {
          "200": { "$ref": "#/components/responses/Ok" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      },
      "delete": {
        "operationId": "removeSpaceMember",
        "tags": ["spaces"],
        "summary": "Remove a member from a space.",
        "description": "Scope: spaces:write.",
        "responses": {
          "200": { "$ref": "#/components/responses/Ok" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/pages/resolve-space": {
      "post": {
        "operationId": "resolvePageSpace",
        "tags": ["pages"],
        "summary": "Resolve a page's owning space id.",
        "description": "For @AuthzDerived route checks. Fail-closed 404 on any miss. Scope: pages:read.",
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/ResolvePageSpaceRequest" },
          "example": { "pageId": "33333333-3333-3333-3333-333333333333" }
        } } },
        "responses": {
          "200": { "description": "The owning space id.", "content": { "application/json": { "schema": { "type": "object", "required": ["pageId", "spaceId"], "properties": { "pageId": { "type": "string", "format": "uuid" }, "spaceId": { "type": "string", "format": "uuid" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/pages/{pageId}/permissions": {
      "parameters": [{ "name": "pageId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": {
        "operationId": "listPagePermissions",
        "tags": ["pages"],
        "summary": "The explicit ACL grants on a page.",
        "description": "page_permissions joined to page_access; grantee by Docmost user/group id (the platform maps user ids to identities). Scope: content:read.",
        "responses": {
          "200": { "description": "The ACL grants.", "content": { "application/json": { "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/RawPagePermission" } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/content/pages/list": {
      "post": {
        "operationId": "listContentPages",
        "tags": ["content"],
        "summary": "Filter-then-retrieve page metadata for an authorized id set.",
        "description": "PRIVILEGED DATA PLANE: returns metadata for EXACTLY the supplied ids (the platform's PDP-authorized set) and does NOT re-authorize. Keyset-ordered by (updated_at desc, id desc); the fork returns up to limit+1 rows so the platform can detect hasMore. Scope: content:read.",
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/ContentListRequest" },
          "example": { "ids": ["33333333-3333-3333-3333-333333333333"], "limit": 50 }
        } } },
        "responses": {
          "200": { "description": "Page summaries (up to limit+1).", "content": { "application/json": { "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/PublicPageSummary" } } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/content/spaces/list": {
      "post": {
        "operationId": "listContentSpaces",
        "tags": ["content"],
        "summary": "Filter-then-retrieve space metadata for an authorized id set.",
        "description": "PRIVILEGED DATA PLANE (see listContentPages). Scope: content:read.",
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/ContentListRequest" },
          "example": { "ids": ["55555555-5555-5555-5555-555555555555"], "limit": 50 }
        } } },
        "responses": {
          "200": { "description": "Space summaries (up to limit+1).", "content": { "application/json": { "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/PublicSpaceSummary" } } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/service/content/spaces/{spaceId}": {
      "parameters": [{ "name": "spaceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": {
        "operationId": "getContentSpace",
        "tags": ["content"],
        "summary": "A single space's public summary (active only).",
        "description": "Scope: content:read.",
        "responses": {
          "200": { "description": "The space summary.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicSpaceSummary" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    },
    "/api/collab/force-disconnect": {
      "post": {
        "operationId": "forceDisconnect",
        "tags": ["collab"],
        "summary": "Force-disconnect a user's live collab session on a page after a revocation.",
        "description": "Close the user's live collaboration connections on a page. The fork RE-CHECKS access before disconnecting (fail-safe): if the user can still access the page, it returns { disconnected: false } without disconnecting. Gated by the same x-authz-service-secret header (no per-route scope on this endpoint) plus RemoteOnlyGuard.",
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "type": "object", "additionalProperties": false, "required": ["userId", "pageId"], "properties": { "userId": { "type": "string", "format": "uuid" }, "pageId": { "type": "string", "format": "uuid" } } },
          "example": { "userId": "11111111-1111-1111-1111-111111111111", "pageId": "22222222-2222-2222-2222-222222222222" }
        } } },
        "responses": {
          "200": { "description": "Whether the user was disconnected (false if a re-check shows they still have access).", "content": { "application/json": { "schema": { "type": "object", "required": ["disconnected"], "properties": { "disconnected": { "type": "boolean" } } }, "example": { "disconnected": true } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/Unconfigured" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "x-authz-service-secret",
        "description": "Shared secret (PLATFORM_AUTHZ_SERVICE_SECRET) sent on every request, compared in constant time."
      }
    },
    "responses": {
      "Ok": {
        "description": "Success (no body of interest).",
        "content": { "application/json": { "schema": { "type": "object", "required": ["ok"], "properties": { "ok": { "type": "boolean" } } } } }
      },
      "BadRequest": {
        "description": "Invalid body (bad shape, unknown key, or a value failing validation).",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "Missing or wrong x-authz-service-secret.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "The credential lacks the required per-route scope.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "The addressed resource does not exist (or is out of the workspace / archived).",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Conflict": {
        "description": "A uniqueness constraint (e.g. the space slug) is already taken.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "RateLimited": {
        "description": "Per-credential, per-scope rate limit exceeded.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unconfigured": {
        "description": "No service secret configured on the fork, OR the fork is not in AUTHZ_MODE=remote (fail-closed).",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "ExternalId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._+-]{1,128}$",
        "description": "The caller's opaque stable identity id; the fork derives the shadow email from it."
      },
      "SpaceMemberRole": { "type": "string", "enum": ["admin", "writer", "reader"] },
      "ProvisionUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["externalId"],
        "properties": {
          "externalId": { "$ref": "#/components/schemas/ExternalId" },
          "name": { "type": "string", "maxLength": 255, "description": "Optional display name for the shadow user." }
        }
      },
      "ResolveUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["userId"],
        "properties": { "userId": { "type": "string", "format": "uuid" } }
      },
      "MintSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["externalId"],
        "properties": { "externalId": { "$ref": "#/components/schemas/ExternalId" } }
      },
      "ProvisionedUser": {
        "type": "object",
        "required": ["userId", "workspaceId"],
        "properties": {
          "userId": { "type": "string", "description": "Docmost user id (opaque to the caller)." },
          "workspaceId": { "type": "string", "description": "The fork's own default workspace id." }
        }
      },
      "WorkspaceSettings": {
        "type": "object",
        "required": ["name", "defaultPageEditMode"],
        "properties": {
          "name": { "type": ["string", "null"] },
          "defaultPageEditMode": { "type": ["string", "null"], "enum": ["read", "edit", null] }
        }
      },
      "UpdateWorkspaceSettingsRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 255 },
          "defaultPageEditMode": { "type": "string", "enum": ["read", "edit"] }
        }
      },
      "SpaceView": {
        "type": "object",
        "required": ["id", "name", "slug", "description", "visibility", "memberCount", "archived", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": ["string", "null"] },
          "slug": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "visibility": { "type": "string" },
          "memberCount": { "type": "integer" },
          "archived": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "RawSpaceMember": {
        "type": "object",
        "required": ["memberId", "userId", "groupId", "role", "createdAt"],
        "properties": {
          "memberId": { "type": "string", "format": "uuid" },
          "userId": { "type": ["string", "null"], "description": "Docmost user id (null for a group member)." },
          "groupId": { "type": ["string", "null"] },
          "role": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateSpaceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "creatorExternalId"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "slug": { "type": "string", "maxLength": 60 },
          "description": { "type": "string", "maxLength": 1000 },
          "creatorExternalId": { "$ref": "#/components/schemas/ExternalId" }
        }
      },
      "UpdateSpaceRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 1000 }
        }
      },
      "AddSpaceMemberRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["externalId", "role", "addedByExternalId"],
        "properties": {
          "externalId": { "$ref": "#/components/schemas/ExternalId" },
          "role": { "$ref": "#/components/schemas/SpaceMemberRole" },
          "addedByExternalId": { "$ref": "#/components/schemas/ExternalId" }
        }
      },
      "UpdateSpaceMemberRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role"],
        "properties": { "role": { "$ref": "#/components/schemas/SpaceMemberRole" } }
      },
      "ResolvePageSpaceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pageId"],
        "properties": {
          "pageId": { "type": "string", "format": "uuid" },
          "includeDeleted": { "type": "boolean" }
        }
      },
      "ContentListRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ids", "limit"],
        "properties": {
          "ids": { "type": "array", "maxItems": 10000, "items": { "type": "string", "format": "uuid" }, "description": "The platform's PDP-authorized id set (the belt). maxItems MUST stay >= the platform's content.maxListAuthorizedIds default (10000) or a well-authorized principal gets a 400; the provider/consumer contract tests enforce this." },
          "spaceId": { "type": "string", "format": "uuid", "description": "Pages only: scope the list to one space." },
          "before": {
            "type": "object",
            "additionalProperties": false,
            "required": ["updatedAt", "id"],
            "properties": { "updatedAt": { "type": "string" }, "id": { "type": "string" } },
            "description": "The decoded keyset cursor position (cursor encode/decode stays on the platform)."
          },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      },
      "PublicPageSummary": {
        "type": "object",
        "required": ["id", "slugId", "title", "icon", "spaceId", "parentPageId", "position", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "slugId": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "icon": { "type": ["string", "null"] },
          "spaceId": { "type": "string", "format": "uuid" },
          "parentPageId": { "type": ["string", "null"] },
          "position": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "PublicSpaceSummary": {
        "type": "object",
        "required": ["id", "name", "slug", "description", "visibility", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": ["string", "null"] },
          "slug": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "visibility": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "RawPagePermission": {
        "type": "object",
        "required": ["id", "userId", "groupId", "role", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "userId": { "type": ["string", "null"], "description": "Docmost user id (null for a group grant)." },
          "groupId": { "type": ["string", "null"] },
          "role": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object",
        "description": "Standard Nest exception body; only the HTTP status is contractual.",
        "properties": {
          "statusCode": { "type": "integer" },
          "message": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    }
  }
}

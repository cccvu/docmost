# Standalone Docmost (AUTHZ_MODE=native) environment.
# Copy to .env in this directory and edit the two secrets below.
#   cp deploy/standalone/.env.example deploy/standalone/.env

# A long random secret for signing Docmost sessions. Generate one:
#   openssl rand -hex 32
APP_SECRET=CHANGE_ME_openssl_rand_hex_32

# Postgres password for the bundled database.
POSTGRES_PASSWORD=docmost

# Public URL the app is served at (used in emails and links).
APP_URL=http://localhost:3000

# Optional overrides:
# DOCMOST_PORT=3000
# MAILPIT_UI_PORT=8025
# MAIL_FROM_ADDRESS=docmost@localhost
# MAIL_FROM_NAME=Docmost

# Note: AUTHZ_MODE is pinned to `native` in docker-compose.yml. Native mode contacts NO external service,
# so PLATFORM_AUTHZ_URL / PLATFORM_AUTHZ_SERVICE_SECRET are intentionally absent. For AUTHZ_MODE=remote,
# see docs/architecture/external-services.md.

diff --git a/dist/yjs.cjs b/dist/yjs.cjs
index d50f7262ce53030e935954a20ee7104fba9c8ea0..4bd7649b02a96730224c332c9a069ce6aa347c03 100644
--- a/dist/yjs.cjs
+++ b/dist/yjs.cjs
@@ -9729,6 +9729,20 @@ const redoItem = (transaction, item, redoitems, itemsToDelete, ignoreRemoteMapCh
       }
       right = right.right;
     }
+    // [ccc #840] yjs #794/#823 (PR #795): the left and right traces above can end on
+    // copies that are not in left-to-right order, which gives the redone item
+    // contradictory origins (live and a reload then order it differently). Keep
+    // the traced left, and fall back to its right neighbour when the traced right
+    // is not reachable from it.
+    if (left !== null && right !== null) {
+      let next = left.right;
+      while (next !== null && next !== right) {
+        next = next.right;
+      }
+      if (next === null) {
+        right = left.right;
+      }
+    }
   } else {
     right = null;
     if (item.right && !ignoreRemoteMapChanges) {
@@ -9748,6 +9762,14 @@ const redoItem = (transaction, item, redoitems, itemsToDelete, ignoreRemoteMapCh
     } else {
       left = parentType._map.get(item.parentSub) || null;
     }
+    // [ccc #840] yjs #757 (upstream fix d9aaff72, released in 13.6.31): when this redo
+    // recreated the parent, the key chain walked above is the old, deleted parent's.
+    // Linking the value there shows it to the undoing user only: its origin is in the
+    // old parent, so every other replica and every reload drop it. Start from the
+    // recreated parent's current value instead.
+    if (left !== null && /** @type {AbstractType<any>} */ (left.parent)._item !== parentItem) {
+      left = parentType._map.get(item.parentSub) || null;
+    }
   }
   const nextClock = getState(store, ownClientID);
   const nextId = createID(ownClientID, nextClock);
